{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://pct.local/schemas/pct-p2-candidate-stop-snapshot-v0.1.schema.json","title":"PCT P2 Candidate-Stop Snapshot v0.1","type":"object","additionalProperties":false,"required":["stop_id","stop_event_id","stop_scope","goal_id","goal_revision","snapshot_id","recovery_authority","obligation_states","evidence_ids","last_sequence","event_log_digest","created_at"],"properties":{"stop_id":{"type":"string","minLength":1},"stop_event_id":{"type":"string","minLength":1},"stop_scope":{"type":"string","enum":["TURN_STOP","GOAL_COMPLETION_PROPOSAL","HUMAN_ESCALATION","NO_FURTHER_ACTION_PROPOSAL","BLOCKER_PROPOSAL","BUDGET_STOP","OTHER"]},"goal_id":{"type":"string","minLength":1},"goal_revision":{"type":"integer","minimum":1},"snapshot_id":{"type":"string","minLength":1},"recovery_authority":{"type":"string","enum":["SELF_SERVICE","HUMAN_ONLY","EXTERNAL_WAIT","IMPOSSIBLE","UNKNOWN","NOT_APPLICABLE"]},"obligation_states":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["obligation_id","kind","severity","state","evidence_ids"],"properties":{"obligation_id":{"type":"string","minLength":1},"kind":{"type":"string","enum":["OUTCOME","DELIVERABLE","INVARIANT","PROCESS","SEMANTIC","EVIDENCE"]},"severity":{"type":"string","enum":["HARD","MAJOR","MINOR"]},"state":{"type":"string","enum":["PENDING","ATTEMPTED","PROVISIONAL","VERIFIED","FAILED","UNKNOWN"]},"evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"last_transition_event_id":{"type":"string","minLength":1}}}},"evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"last_sequence":{"type":"integer","minimum":1},"event_log_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"created_at":{"type":"string","format":"date-time"}}}