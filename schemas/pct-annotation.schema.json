{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pct/schemas/pct-annotation.schema.json",
  "title": "PCT Candidate-Stop Annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "annotation_id",
    "trajectory_id",
    "stop_id",
    "annotator",
    "outcome_verdict",
    "process_verdict",
    "certification_recommendation",
    "certification_effects",
    "failure_codes",
    "hard_gate_codes",
    "first_invalid_transition",
    "evidence_assessment",
    "valid_alternative_path",
    "citations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "stop_id": {
      "type": "string",
      "minLength": 1
    },
    "annotator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotator_id",
        "role",
        "blinded_to_reference_truth",
        "blinded_to_other_annotations"
      ],
      "properties": {
        "annotator_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "HUMAN",
            "AUDIT_AGENT",
            "ADJUDICATOR",
            "FIXTURE_AUTHOR"
          ]
        },
        "blinded_to_reference_truth": {
          "type": "boolean"
        },
        "blinded_to_other_annotations": {
          "type": "boolean"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome_verdict": {
      "$ref": "#/$defs/fourWayVerdict"
    },
    "process_verdict": {
      "$ref": "#/$defs/fourWayVerdict"
    },
    "certification_recommendation": {
      "enum": [
        "ACCEPT",
        "CONTINUE",
        "EVIDENCE_REQUIRED",
        "HUMAN_REQUIRED",
        "BLOCKED",
        "NO_PROGRESS",
        "UNDETERMINED"
      ]
    },
    "certification_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "HARD_VIOLATION",
          "EVIDENCE_GAP",
          "OUTCOME_FAILURE",
          "SOFT_QUALITY_ISSUE",
          "LIMITATION",
          "NONE",
          "UNKNOWN"
        ]
      }
    },
    "failure_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+\\.[A-Z0-9_]+$"
      },
      "uniqueItems": true
    },
    "hard_gate_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+\\.[A-Z0-9_]+$"
      },
      "uniqueItems": true
    },
    "first_invalid_transition": {
      "$ref": "#/$defs/localization"
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sufficiency",
        "currentness",
        "scope_match",
        "conflicts_resolved"
      ],
      "properties": {
        "sufficiency": {
          "$ref": "#/$defs/fourWayVerdict"
        },
        "currentness": {
          "$ref": "#/$defs/fourWayVerdict"
        },
        "scope_match": {
          "$ref": "#/$defs/fourWayVerdict"
        },
        "conflicts_resolved": {
          "$ref": "#/$defs/fourWayVerdict"
        }
      }
    },
    "valid_alternative_path": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN"
      ]
    },
    "citations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ids",
        "evidence_ids"
      ],
      "properties": {
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "rationale": {
      "type": "string"
    },
    "uncertainty_note": {
      "type": "string"
    }
  },
  "$defs": {
    "fourWayVerdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "confidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "EXACT",
            "RANGE",
            "NONE",
            "UNKNOWN"
          ]
        },
        "event_id": {
          "type": "string"
        },
        "start_event_id": {
          "type": "string"
        },
        "end_event_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
