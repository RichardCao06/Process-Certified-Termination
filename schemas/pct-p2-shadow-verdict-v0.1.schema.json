{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pct.local/schemas/pct-p2-shadow-verdict-v0.1.schema.json",
  "title": "PCT P2 Shadow Verdict Envelope v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "mode",
    "applied_to_runtime",
    "stop_id",
    "stop_event_id",
    "snapshot_digest",
    "event_log_digest",
    "findings",
    "citations",
    "verdict_status",
    "labels_emitted",
    "metadata_status",
    "deterministic_decision_covered"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "mode": {
      "const": "SHADOW"
    },
    "applied_to_runtime": {
      "const": false
    },
    "stop_id": {
      "type": "string",
      "minLength": 1
    },
    "stop_event_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_log_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "MISSING",
        "LEGACY_EXPLICIT"
      ]
    },
    "sidecar_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sidecar_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "deterministic_decision_covered": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "category",
          "message",
          "event_ids",
          "evidence_ids",
          "enforcement"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "enforcement": {
            "type": "string",
            "enum": [
              "DESCRIPTIVE_PENDING_P2_D03",
              "FROZEN_HARD",
              "FROZEN_DESCRIPTIVE",
              "UNREGISTERED_DESCRIPTIVE"
            ]
          },
          "suggested_failure_code": {
            "type": "string",
            "minLength": 1
          },
          "suggested_recommendation": {
            "type": "string",
            "enum": [
              "ACCEPT",
              "CONTINUE",
              "EVIDENCE_REQUIRED",
              "HUMAN_REQUIRED",
              "BLOCKED",
              "NO_PROGRESS",
              "UNDETERMINED",
              "INCIDENT_ESCALATION"
            ]
          }
        }
      }
    },
    "citations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ids",
        "evidence_ids"
      ],
      "properties": {
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verdict_status": {
      "type": "string",
      "enum": [
        "POLICY_PENDING",
        "EMITTED"
      ]
    },
    "labels_emitted": {
      "type": "boolean"
    },
    "policy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "open_decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accept_decision": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "DO_NOT_ACCEPT"
      ]
    },
    "outcome_verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "process_verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "stop_scope": {
      "type": "string",
      "enum": [
        "TURN_STOP",
        "GOAL_COMPLETION_PROPOSAL",
        "HUMAN_ESCALATION",
        "NO_FURTHER_ACTION_PROPOSAL",
        "BLOCKER_PROPOSAL",
        "BUDGET_STOP",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "recovery_authority": {
      "type": "string",
      "enum": [
        "SELF_SERVICE",
        "HUMAN_ONLY",
        "EXTERNAL_WAIT",
        "IMPOSSIBLE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "certification_recommendation": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "CONTINUE",
        "EVIDENCE_REQUIRED",
        "HUMAN_REQUIRED",
        "BLOCKED",
        "NO_PROGRESS",
        "UNDETERMINED",
        "INCIDENT_ESCALATION"
      ]
    },
    "hard_check_ids_triggered": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict_status": {
            "const": "POLICY_PENDING"
          }
        },
        "required": [
          "verdict_status"
        ]
      },
      "then": {
        "properties": {
          "labels_emitted": {
            "const": false
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "accept_decision"
              ]
            },
            {
              "required": [
                "process_verdict"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict_status": {
            "const": "EMITTED"
          }
        },
        "required": [
          "verdict_status"
        ]
      },
      "then": {
        "properties": {
          "labels_emitted": {
            "const": true
          }
        },
        "required": [
          "accept_decision",
          "outcome_verdict",
          "process_verdict",
          "stop_scope",
          "recovery_authority",
          "certification_recommendation",
          "hard_check_ids_triggered",
          "human_review_required"
        ]
      }
    }
  ]
}
