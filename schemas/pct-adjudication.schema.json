{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pct/schemas/pct-adjudication.schema.json",
  "title": "PCT P1 Annotation Adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adjudication_id",
    "trajectory_id",
    "stop_id",
    "input_annotation_ids",
    "disagreement_types",
    "adjudicated_annotation_id",
    "retained_ambiguity",
    "codebook_change_required",
    "taxonomy_change_required",
    "rationale",
    "adjudicator_identity",
    "adjudicator_role"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "adjudication_id": {
      "type": "string",
      "minLength": 1
    },
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "stop_id": {
      "type": "string",
      "minLength": 1
    },
    "input_annotation_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "disagreement_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "VERDICT",
          "FAILURE_CODE",
          "HARD_GATE",
          "LOCALIZATION",
          "VALID_ALTERNATIVE_PATH",
          "EVIDENCE_ASSESSMENT",
          "OTHER"
        ]
      }
    },
    "adjudicated_annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "retained_ambiguity": {
      "type": "boolean"
    },
    "codebook_change_required": {
      "type": "boolean"
    },
    "taxonomy_change_required": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "adjudicator_identity": {
      "type": "string",
      "minLength": 1
    },
    "adjudicator_role": {
      "enum": [
        "HUMAN_ADJUDICATOR"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
