{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pct/schemas/pct-adjudication-v0.2.schema.json",
  "title": "PCT Calibration Adjudication v0.2 Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adjudication_id", "trajectory_id", "stop_id",
    "input_annotation_ids", "disagreement_types", "adjudicated_annotation_id",
    "retained_ambiguity", "pending_decision_ids", "codebook_change_required",
    "taxonomy_change_required", "rationale", "adjudicator_identity",
    "adjudicator_role", "human_acceptance_source", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "0.2-draft"},
    "adjudication_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "stop_id": {"type": "string", "minLength": 1},
    "input_annotation_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "disagreement_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [
      "VERDICT", "FAILURE_CODE", "HARD_GATE", "LOCALIZATION",
      "VALID_ALTERNATIVE_PATH", "EVIDENCE_ASSESSMENT", "OTHER"
    ]}},
    "adjudicated_annotation_id": {"type": "string", "minLength": 1},
    "retained_ambiguity": {"type": "boolean"},
    "pending_decision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PCT-P1-D[0-9]{2}$"}},
    "codebook_change_required": {"type": "boolean"},
    "taxonomy_change_required": {"type": "boolean"},
    "rationale": {"type": "string", "minLength": 20},
    "adjudicator_identity": {"type": "string", "minLength": 1},
    "adjudicator_role": {"const": "HUMAN_ADJUDICATOR"},
    "human_acceptance_source": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
