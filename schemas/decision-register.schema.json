{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pct/decision-register.schema.json",
  "title": "PCT Decision Register",
  "type": "object",
  "required": [
    "project_id",
    "phase",
    "version",
    "decisions"
  ],
  "properties": {
    "project_id": {
      "const": "PCT"
    },
    "phase": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "normative",
          "blocks_p0",
          "owner_role",
          "status",
          "options",
          "agent_recommendation"
        ],
        "properties": {
          "id": {
            "pattern": "^PCT-P[0-9]+-D[0-9]{2}$"
          },
          "status": {
            "enum": [
              "pending-human",
              "approved",
              "rejected",
              "deferred"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 2
          }
        }
      }
    }
  }
}
